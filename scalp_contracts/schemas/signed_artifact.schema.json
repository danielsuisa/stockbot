{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scalp_contracts/schemas/signed_artifact.schema.json",
  "title": "Signed artifact digest envelope, schema_version 1",
  "description": "payload must also validate against artifact_digest.schema.json. The signature covers DOMAIN + 0x0A + canonical(payload), with DOMAIN = 'scalp-engine/artifact/v1' (ADR 0010 section 1.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "payload",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "canonicalization",
        "key_id",
        "value"
      ],
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "canonicalization": {
          "const": "RFC8785-ascii-nofloat"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "First 16 hex chars of sha256 of the raw 32-byte public key."
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "description": "64-byte Ed25519 signature, base64url without padding."
        }
      }
    }
  }
}
