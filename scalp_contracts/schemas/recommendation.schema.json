{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scalp_contracts/schemas/recommendation.schema.json",
  "title": "Bracket-order recommendation (L5 card payload), schema_version 1",
  "description": "The payload that L5 signs and L7 verifies. Prices, probabilities and other fractional values are decimal strings: the canonical form has no floats (ADR 0001 section 5.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "rec_id", "created_at", "symbol", "side", "qty", "entry", "stop_price",
    "target_price", "ttl_seconds", "p", "horizon_minutes", "model_version", "feature_versions",
    "regime", "risk_checks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "rec_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$"},
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "description": "UTC, suffix Z."
    },
    "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,9}$"},
    "side": {"enum": ["long", "short"]},
    "qty": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "limit_price"],
          "properties": {
            "type": {"const": "LMT"},
            "limit_price": {"$comment": "decimal string", "type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{2,4}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "stop_price", "limit_price"],
          "properties": {
            "type": {"const": "STP_LMT"},
            "stop_price": {"type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{2,4}$"},
            "limit_price": {"type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{2,4}$"}
          }
        }
      ]
    },
    "stop_price": {"type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{2,4}$"},
    "target_price": {"type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{2,4}$"},
    "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "p": {
      "type": "string",
      "pattern": "^(0(\\.[0-9]{1,6})?|1(\\.0{1,6})?)$",
      "description": "Calibrated probability of the predicted label, decimal string in [0, 1]."
    },
    "horizon_minutes": {"type": "integer", "minimum": 1, "maximum": 390},
    "model_version": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]{1,64}$"},
    "feature_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+\\+[0-9a-f]{12}$",
        "description": "Feature id: name@semver+first 12 hex of the sha256 of the defining code (ADR 0001 section 3.6)."
      }
    },
    "regime": {"enum": ["trend", "chop", "event"]},
    "risk_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "passed", "detail"],
        "properties": {
          "check": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "passed": {"type": "boolean"},
          "detail": {"type": "string", "maxLength": 200}
        }
      }
    }
  }
}
