{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scalp_contracts/schemas/feature_definition.schema.json",
  "title": "Feature definition record (feature registry entry), schema_version 1 or 2",
  "description": "feature_id = name@version+code_hash[:12]. code_hash is sha256 of the canonical source of the defining function(s). Any change to code_hash requires a new version; a registry entry is never edited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "code_hash",
    "feature_id",
    "inputs",
    "availability_rule",
    "description"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "code_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+\\+[0-9a-f]{12}$"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_@.+]{0,127}$"
      },
      "description": "Raw table names or upstream feature ids."
    },
    "availability_rule": {
      "type": "string",
      "description": "How available_at is derived, e.g. 'bar close + 1s'."
    },
    "description": {
      "type": "string"
    },
    "window": {
      "type": "string"
    },
    "feed": {
      "enum": [
        "iex",
        "sip",
        "none",
        "variant"
      ]
    },
    "live_profile": {
      "enum": [
        "iex_realtime",
        "sip_delayed_15m",
        "sip_eod",
        "research_only",
        "public_realtime",
        "public_eod",
        "variant"
      ]
    }
  }
}
